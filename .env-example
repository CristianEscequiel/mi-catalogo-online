DB_PORT=5432
DB_NAME=my_catalog_db
DB_USER=catalog_user
DB_PASSWORD=replace_with_strong_password

# Mínimo 32 caracteres en producción (el backend no arranca con uno más corto)
JWT_SECRET=replace_with_strong_jwt_secret_of_32_chars_or_more
# Obligatoria en producción: lista de orígenes separados por coma. No acepta "*".
CORS_ORIGIN=http://localhost:8080

# Obligatorias: el backend no arranca sin ellas
OPENAI_API_KEY=replace_with_openai_api_key
RESEND_API_KEY=replace_with_resend_api_key
CONTACT_TO_EMAIL=contacto@example.com
# Opcionales (con valor por defecto)
# MAIL_FROM=no-reply@example.com
# FRONTEND_URL=http://localhost:8080

# Horas antes de cancelar una orden sin pago y devolver su stock (default 48)
ORDER_PAYMENT_TTL_HOURS=48

# Llamadas a la IA permitidas por usuario y ventana en segundos (default 20 por 3600)
AI_RATE_LIMIT=20
AI_RATE_TTL_SECONDS=3600
