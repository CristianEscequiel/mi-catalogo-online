FRONTEND_PORT=8080
BACKEND_PORT=3000

DB_PORT=5432
DB_NAME=my_catalog_db
DB_USER=catalog_user
DB_PASSWORD=replace_with_strong_password

JWT_SECRET=replace_with_strong_jwt_secret
